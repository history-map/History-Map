<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Chronicle Atlas — The Atlantic Age, 1770–1860</title>

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.css" />
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600;9..144,700&family=IBM+Plex+Mono:wght@400;500;600&family=Source+Sans+3:wght@400;500;600&display=swap" rel="stylesheet">

<style>
  :root{
    --ink:#0b1420;
    --panel:#0f1b28;
    --paper:#e9e0c9;
    --paper-dim:#a9a08a;
    --brass:#c9a227;
    --brass-dim:#8a7220;
    --line: rgba(233,224,201,0.14);

    --c-conflict:#a63d2f;
    --c-discovery:#3f8c7a;
    --c-science:#c9a227;
    --c-politics:#5c7a99;
    --c-culture:#8a6aa0;
    --c-disaster:#8a8f98;
  }

  *{box-sizing:border-box;}
  html,body{height:100%;margin:0;}
  body{
    background:var(--ink);
    color:var(--paper);
    font-family:'Source Sans 3', sans-serif;
    overflow:hidden;
  }

  #map{ position:absolute; inset:0; background:var(--ink); }

  /* ---------- Header ---------- */
  .topbar{
    position:absolute; top:0; left:0; right:0; z-index:900;
    display:flex; align-items:baseline; justify-content:space-between;
    padding:22px 28px 0 28px;
    pointer-events:none;
  }
  .brand{ pointer-events:auto; }
  .eyebrow{
    font-family:'IBM Plex Mono', monospace;
    font-size:11px; letter-spacing:.22em; text-transform:uppercase;
    color:var(--brass); margin:0 0 4px 0;
  }
  .brand h1{
    font-family:'Fraunces', serif; font-weight:600; font-size:26px; margin:0;
    color:var(--paper); letter-spacing:.01em;
    text-shadow:0 2px 12px rgba(0,0,0,.5);
  }

  .legend{
    pointer-events:auto;
    background:rgba(11,20,32,0.82);
    border:1px solid var(--line);
    border-radius:10px;
    padding:12px 16px;
    backdrop-filter:blur(6px);
    font-family:'IBM Plex Mono', monospace;
    font-size:11px;
  }
  .legend-title{
    color:var(--paper-dim); text-transform:uppercase; letter-spacing:.14em;
    font-size:10px; margin-bottom:8px;
  }
  .legend-row{
    display:flex; align-items:center; gap:8px; margin:5px 0;
    cursor:pointer; user-select:none; opacity:1; transition:opacity .15s ease;
  }
  .legend-row.off{ opacity:.32; }
  .dot{
    width:9px; height:9px; border-radius:50%; flex:0 0 auto;
    box-shadow:0 0 0 1px rgba(0,0,0,.4);
  }
  .legend-row span.label{ color:var(--paper); font-size:11.5px; letter-spacing:.01em;}

  /* ---------- Bottom instrument (timeline) ---------- */
  .instrument{
    position:absolute; left:0; right:0; bottom:0; z-index:900;
    background:linear-gradient(180deg, rgba(11,20,32,0) 0%, rgba(11,20,32,0.92) 26%, rgba(11,20,32,0.98) 100%);
    padding-top:60px;
  }
  .instrument-inner{ max-width:1180px; margin:0 auto; padding:0 28px 22px 28px; }

  .year-readout{ display:flex; align-items:flex-end; gap:18px; margin-bottom:10px; }
  .year-readout .year{
    font-family:'Fraunces', serif; font-weight:700; font-size:64px; line-height:1;
    color:var(--brass); letter-spacing:.01em;
    text-shadow:0 2px 20px rgba(201,162,39,0.25);
    min-width:190px;
    font-variant-numeric: tabular-nums;
  }
  .year-meta{ font-family:'IBM Plex Mono', monospace; font-size:12px; color:var(--paper-dim); padding-bottom:12px; }
  .year-meta strong{ color:var(--paper); font-weight:600;}

  .controls-row{ display:flex; align-items:center; gap:14px; }

  .playbtn{
    flex:0 0 auto; width:42px;height:42px; border-radius:50%;
    border:1px solid var(--brass-dim);
    background:rgba(201,162,39,0.08);
    color:var(--brass); cursor:pointer;
    display:flex;align-items:center;justify-content:center; font-size:15px;
    transition:background .15s ease, transform .1s ease;
  }
  .playbtn:hover{ background:rgba(201,162,39,0.18); }
  .playbtn:active{ transform:scale(0.94); }

  .slider-wrap{ flex:1 1 auto; position:relative; padding-top:6px; }

  .ticks{
    display:flex; justify-content:space-between;
    font-family:'IBM Plex Mono', monospace; font-size:9.5px; color:var(--paper-dim);
    padding:0 2px; margin-bottom:4px; letter-spacing:.02em;
  }

  input[type=range]{
    -webkit-appearance:none; appearance:none; width:100%; height:4px; border-radius:2px;
    background:linear-gradient(90deg, var(--brass-dim), var(--line));
    outline:none; cursor:pointer;
  }
  input[type=range]::-webkit-slider-thumb{
    -webkit-appearance:none; width:18px; height:18px; border-radius:50%;
    background:radial-gradient(circle at 35% 30%, #f0d878, var(--brass) 60%, var(--brass-dim) 100%);
    border:2px solid var(--ink);
    box-shadow:0 0 0 1px var(--brass), 0 2px 8px rgba(0,0,0,.5);
    cursor:pointer; margin-top:-7px;
  }
  input[type=range]::-moz-range-thumb{
    width:16px; height:16px; border-radius:50%;
    background:radial-gradient(circle at 35% 30%, #f0d878, var(--brass) 60%, var(--brass-dim) 100%);
    border:2px solid var(--ink); cursor:pointer;
  }
  input[type=range]::-moz-range-track{ height:4px; border-radius:2px; background:var(--line); }

  .speed-select{
    flex:0 0 auto; font-family:'IBM Plex Mono', monospace; font-size:11px;
    background:transparent; color:var(--paper-dim);
    border:1px solid var(--line); border-radius:6px; padding:9px 8px; cursor:pointer;
  }
  .speed-select:hover{ color:var(--paper); border-color:var(--brass-dim); }

  /* ---------- Popup styling ---------- */
  .leaflet-popup-content-wrapper{
    background:var(--panel); color:var(--paper);
    border:1px solid var(--line); border-radius:8px;
    box-shadow:0 8px 30px rgba(0,0,0,.5);
  }
  .leaflet-popup-tip{ background:var(--panel); border:1px solid var(--line);}
  .leaflet-popup-content{ margin:14px 16px; font-family:'Source Sans 3', sans-serif; }
  .pop-cat{
    font-family:'IBM Plex Mono', monospace; font-size:10px;
    text-transform:uppercase; letter-spacing:.14em; margin-bottom:5px;
  }
  .pop-year{ font-family:'IBM Plex Mono', monospace; color:var(--brass); font-size:12px; margin-bottom:4px; }
  .pop-title{ font-family:'Fraunces', serif; font-weight:600; font-size:17px; margin:0 0 6px 0; color:var(--paper); }
  .pop-desc{ font-size:13px; line-height:1.5; color:#cfc6ab; }
  .leaflet-popup-close-button{ color:var(--paper-dim) !important; }
  .leaflet-container a.leaflet-popup-close-button:hover{ color:var(--paper) !important; }

  ::-webkit-scrollbar{ width:8px; }
  ::-webkit-scrollbar-thumb{ background:var(--line); border-radius:4px; }

  @media (max-width:720px){
    .year-readout .year{ font-size:42px; min-width:auto;}
    .legend{ display:none; }
    .topbar{ padding:16px 16px 0 16px; }
    .instrument-inner{ padding:0 16px 16px 16px; }
  }
</style>
</head>
<body>

<div id="map"></div>

<div class="topbar">
  <div class="brand">
    <p class="eyebrow">Revolutions &amp; reckonings</p>
    <h1>Chronicle Atlas — The Atlantic Age</h1>
  </div>
  <div class="legend" id="legend"></div>
</div>

<div class="instrument">
  <div class="instrument-inner">
    <div class="year-readout">
      <div class="year" id="yearDisplay">1776</div>
      <div class="year-meta" id="yearMeta">Drag the dial or press play to travel through time.</div>
    </div>
    <div class="controls-row">
      <button class="playbtn" id="playBtn" title="Play / pause" aria-label="Play or pause timeline">&#9654;</button>
      <div class="slider-wrap">
        <div class="ticks" id="ticks"></div>
        <input type="range" id="yearSlider" min="1770" max="1860" step="1" value="1776">
      </div>
      <select class="speed-select" id="speedSelect" title="Playback speed">
        <option value="700">Slow</option>
        <option value="350" selected>Normal</option>
        <option value="140">Fast</option>
      </select>
    </div>
  </div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.js"></script>
<script>
/* =========================================================
   1. EVENT DATA — North America & Europe, 1770–1860
   category options: conflict, discovery, science, politics, culture, disaster
   ========================================================= */
const EVENTS = [
  { year: 1770, lat: 42.36, lng: -71.06, title: "Boston Massacre", category: "conflict", desc: "British soldiers fired on a crowd of colonists in Boston, hardening colonial opposition to British rule." },
  { year: 1773, lat: 42.36, lng: -71.06, title: "Boston Tea Party", category: "politics", desc: "Colonists boarded British ships and destroyed tea shipments to protest taxation without representation." },
  { year: 1775, lat: 42.44, lng: -71.24, title: "Lexington and Concord", category: "conflict", desc: "The first armed clashes of the American Revolutionary War broke out in Massachusetts." },
  { year: 1776, lat: 39.95, lng: -75.16, title: "Declaration of Independence", category: "politics", desc: "The Second Continental Congress in Philadelphia declared the thirteen colonies free of British rule." },
  { year: 1777, lat: 43.05, lng: -73.65, title: "Battle of Saratoga", category: "conflict", desc: "An American victory in New York proved a turning point, helping secure French support for the Revolution." },
  { year: 1781, lat: 37.24, lng: -76.51, title: "Siege of Yorktown", category: "conflict", desc: "A combined American and French force compelled the surrender of a major British army in Virginia." },
  { year: 1783, lat: 48.85, lng: 2.35, title: "Treaty of Paris", category: "politics", desc: "Britain formally recognized the independence of the United States, ending the Revolutionary War." },
  { year: 1787, lat: 39.95, lng: -75.16, title: "US Constitutional Convention", category: "politics", desc: "Delegates meeting in Philadelphia drafted a new framework of federal government for the United States." },
  { year: 1789, lat: 48.86, lng: 2.35, title: "Storming of the Bastille", category: "politics", desc: "Parisians attacked the fortress-prison, a flashpoint that ignited the French Revolution." },
  { year: 1791, lat: 38.9, lng: -77.03, title: "US Bill of Rights ratified", category: "politics", desc: "Ten amendments guaranteeing individual liberties were added to the US Constitution." },
  { year: 1793, lat: 48.86, lng: 2.35, title: "Execution of Louis XVI", category: "politics", desc: "The French king was executed by guillotine, radicalizing the revolution and alarming monarchies across Europe." },
  { year: 1798, lat: 53.35, lng: -6.26, title: "Irish Rebellion", category: "conflict", desc: "Irish republicans, inspired by revolutionary France, rose up against British rule and were suppressed." },
  { year: 1799, lat: 48.86, lng: 2.35, title: "Napoleon's coup of 18 Brumaire", category: "politics", desc: "Napoleon Bonaparte seized power in France, ending the Revolution's chaotic decade and beginning his rise." },
  { year: 1803, lat: 29.95, lng: -90.07, title: "Louisiana Purchase", category: "politics", desc: "The United States bought a vast western territory from France, roughly doubling the country's size." },
  { year: 1804, lat: 48.85, lng: 2.35, title: "Napoleon crowned Emperor", category: "politics", desc: "Napoleon crowned himself Emperor of the French at Notre-Dame Cathedral in Paris." },
  { year: 1805, lat: 36.18, lng: -6.03, title: "Battle of Trafalgar", category: "conflict", desc: "The British navy under Nelson decisively defeated the combined French and Spanish fleets off Spain's coast." },
  { year: 1807, lat: 51.5, lng: -0.13, title: "British Slave Trade Act", category: "politics", desc: "Britain outlawed the transatlantic slave trade within its empire, a landmark in the abolitionist movement." },
  { year: 1812, lat: 38.9, lng: -77.03, title: "War of 1812 begins", category: "conflict", desc: "The United States declared war on Britain over trade restrictions and other grievances." },
  { year: 1814, lat: 38.9, lng: -77.03, title: "Burning of Washington", category: "conflict", desc: "British forces captured and burned the US capital, including the White House, during the War of 1812." },
  { year: 1814, lat: 48.21, lng: 16.37, title: "Congress of Vienna opens", category: "politics", desc: "European powers convened in Vienna to redraw the continent's map after Napoleon's defeat." },
  { year: 1815, lat: 50.68, lng: 4.4, title: "Battle of Waterloo", category: "conflict", desc: "Napoleon's final defeat near Brussels ended his rule and closed the Napoleonic Wars." },
  { year: 1819, lat: 53.48, lng: -2.24, title: "Peterloo Massacre", category: "conflict", desc: "Cavalry charged a crowd demanding parliamentary reform in Manchester, killing several protesters." },
  { year: 1820, lat: 38.9, lng: -77.03, title: "Missouri Compromise", category: "politics", desc: "The US Congress brokered a deal balancing free and slave states, deferring the conflict over slavery's expansion." },
  { year: 1825, lat: 43.16, lng: -77.61, title: "Erie Canal completed", category: "discovery", desc: "A canal linking the Great Lakes to the Hudson River transformed trade and westward expansion in the US." },
  { year: 1829, lat: 51.5, lng: -0.13, title: "Catholic Emancipation", category: "politics", desc: "Britain removed most legal restrictions on Roman Catholics, a major shift in civil rights." },
  { year: 1830, lat: 48.86, lng: 2.35, title: "July Revolution", category: "politics", desc: "Parisians overthrew King Charles X in three days of unrest, installing a more liberal monarchy." },
  { year: 1832, lat: 51.5, lng: -0.13, title: "Great Reform Act", category: "politics", desc: "Britain expanded voting rights and redrew parliamentary districts, curbing aristocratic control of Parliament." },
  { year: 1833, lat: 51.5, lng: -0.13, title: "Slavery Abolition Act", category: "politics", desc: "Britain abolished slavery across most of its empire, freeing enslaved people in its colonies." },
  { year: 1836, lat: 29.42, lng: -98.49, title: "Battle of the Alamo", category: "conflict", desc: "Mexican forces overwhelmed Texan defenders at San Antonio during the Texas Revolution." },
  { year: 1837, lat: 51.5, lng: -0.13, title: "Victoria becomes Queen", category: "culture", desc: "Victoria ascended the British throne at eighteen, beginning a reign that would define an era." },
  { year: 1838, lat: 35.05, lng: -85.31, title: "Trail of Tears", category: "disaster", desc: "The US government forcibly removed Cherokee and other Native peoples westward; thousands died along the way." },
  { year: 1844, lat: 38.9, lng: -77.03, title: "First long-distance telegraph", category: "science", desc: "Samuel Morse sent the first message over a working telegraph line between Washington and Baltimore." },
  { year: 1845, lat: 51.55, lng: -9.27, title: "Great Famine begins in Ireland", category: "disaster", desc: "Potato blight destroyed harvests across Ireland, leading to mass starvation and emigration." },
  { year: 1846, lat: 25.9, lng: -97.47, title: "Mexican-American War begins", category: "conflict", desc: "Fighting broke out along the disputed Texas border, leading to a war that reshaped North America's map." },
  { year: 1848, lat: 50.11, lng: 8.68, title: "Revolutions of 1848", category: "politics", desc: "A wave of liberal and nationalist uprisings swept across European cities from Paris to Frankfurt." },
  { year: 1848, lat: 42.91, lng: -76.8, title: "Seneca Falls Convention", category: "culture", desc: "The first major US women's rights convention convened in New York, launching the organized suffrage movement." },
  { year: 1849, lat: 38.8, lng: -120.89, title: "California Gold Rush peak", category: "discovery", desc: "Hundreds of thousands rushed to California after gold was found at Sutter's Mill, transforming the American West." },
  { year: 1850, lat: 38.9, lng: -77.03, title: "Compromise of 1850", category: "politics", desc: "US Congress passed a package of laws attempting to defuse rising tension between free and slave states." },
  { year: 1854, lat: 44.6, lng: 33.53, title: "Crimean War begins", category: "conflict", desc: "Russia clashed with an alliance including Britain, France, and the Ottoman Empire over influence in the Black Sea region." },
  { year: 1859, lat: 51.5, lng: -0.13, title: "On the Origin of Species", category: "science", desc: "Charles Darwin published his theory of evolution by natural selection in London." },
  { year: 1860, lat: 39.8, lng: -89.64, title: "Lincoln elected President", category: "politics", desc: "Abraham Lincoln's election on an anti-slavery-expansion platform pushed the US toward civil war." },
];

const CATEGORY_META = {
  conflict:  { label: "Conflict",   color: "#a63d2f" },
  discovery: { label: "Discovery",  color: "#3f8c7a" },
  science:   { label: "Science & Tech", color: "#c9a227" },
  politics:  { label: "Politics",   color: "#5c7a99" },
  culture:   { label: "Culture",    color: "#8a6aa0" },
  disaster:  { label: "Disaster",   color: "#8a8f98" },
};

/* =========================================================
   2. MAP SETUP — centered on the Atlantic, framing NA + Europe
   ========================================================= */
const map = L.map('map', {
  worldCopyJump: true,
  zoomControl: false,
  minZoom: 2,
}).setView([38, -35], 3);

L.control.zoom({ position: 'bottomright' }).addTo(map);

L.tileLayer('https://{s}.basemaps.cartocdn.com/dark_nolabels/{z}/{x}/{y}{r}.png', {
  attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors &copy; <a href="https://carto.com/attributions">CARTO</a>',
  subdomains: 'abcd',
  maxZoom: 19,
}).addTo(map);

/* =========================================================
   3. MARKERS
   ========================================================= */
const activeCategories = new Set(Object.keys(CATEGORY_META));
let markers = [];

function makeIcon(cat){
  const color = CATEGORY_META[cat].color;
  const html = `<div style="
      width:16px;height:16px;border-radius:50%;
      background:radial-gradient(circle at 35% 30%, ${color}dd, ${color} 70%);
      border:2px solid #0b1420;
      box-shadow:0 0 0 1px ${color}, 0 0 10px ${color}99;
    "></div>`;
  return L.divIcon({ html, className: '', iconSize: [16,16], iconAnchor: [8,8] });
}

function buildMarkers(){
  markers.forEach(m => map.removeLayer(m));
  markers = [];
  EVENTS.forEach(ev => {
    const marker = L.marker([ev.lat, ev.lng], { icon: makeIcon(ev.category) });
    const meta = CATEGORY_META[ev.category];
    marker.bindPopup(`
      <div class="pop-cat" style="color:${meta.color}">${meta.label}</div>
      <div class="pop-year">${ev.year}</div>
      <div class="pop-title">${ev.title}</div>
      <div class="pop-desc">${ev.desc}</div>
    `);
    marker._ev = ev;
    markers.push(marker);
  });
}
buildMarkers();

function refreshMarkers(){
  const year = parseInt(slider.value, 10);
  let visibleCount = 0;
  markers.forEach(m => {
    const show = m._ev.year === year && activeCategories.has(m._ev.category);
    const onMap = map.hasLayer(m);
    if (show && !onMap) m.addTo(map);
    if (!show && onMap) map.removeLayer(m);
    if (show) visibleCount++;
  });
  updateMeta(year, visibleCount);
}

function updateMeta(year, count){
  if (count > 0){
    yearMeta.innerHTML = `<strong>${count}</strong> event${count>1?'s':''} on the map this year.`;
    return;
  }
  const years = [...new Set(EVENTS.map(e=>e.year))].sort((a,b)=>a-b);
  const prev = [...years].reverse().find(y => y < year);
  const next = years.find(y => y > year);
  let hint = 'No recorded events this year.';
  if (prev !== undefined && next !== undefined) hint = `No events in ${year}. Nearest: ${prev} and ${next}.`;
  else if (prev !== undefined) hint = `No events in ${year}. Nearest earlier: ${prev}.`;
  else if (next !== undefined) hint = `No events in ${year}. Nearest later: ${next}.`;
  yearMeta.textContent = hint;
}

/* =========================================================
   4. LEGEND
   ========================================================= */
const legendEl = document.getElementById('legend');
legendEl.innerHTML = '<div class="legend-title">Categories</div>' +
  Object.entries(CATEGORY_META).map(([key, meta]) => `
    <div class="legend-row" data-cat="${key}">
      <span class="dot" style="background:${meta.color}"></span>
      <span class="label">${meta.label}</span>
    </div>
  `).join('');

legendEl.querySelectorAll('.legend-row').forEach(row => {
  row.addEventListener('click', () => {
    const cat = row.dataset.cat;
    if (activeCategories.has(cat)){ activeCategories.delete(cat); row.classList.add('off'); }
    else { activeCategories.add(cat); row.classList.remove('off'); }
    refreshMarkers();
  });
});

/* =========================================================
   5. SLIDER / TIMELINE
   ========================================================= */
const slider = document.getElementById('yearSlider');
const yearDisplay = document.getElementById('yearDisplay');
const yearMeta = document.getElementById('yearMeta');
const playBtn = document.getElementById('playBtn');
const speedSelect = document.getElementById('speedSelect');
const ticksEl = document.getElementById('ticks');

const MIN_YEAR = parseInt(slider.min, 10);
const MAX_YEAR = parseInt(slider.max, 10);

// build tick labels every 10 years
(function buildTicks(){
  const step = 10;
  let html = '';
  for (let y = MIN_YEAR; y <= MAX_YEAR; y += step) html += `<span>${y}</span>`;
  ticksEl.innerHTML = html;
})();

function setYear(y){
  slider.value = y;
  yearDisplay.textContent = y;
  refreshMarkers();
}

slider.addEventListener('input', () => setYear(parseInt(slider.value, 10)));

let playTimer = null;
function stopPlay(){
  clearInterval(playTimer);
  playTimer = null;
  playBtn.innerHTML = '&#9654;';
}
function startPlay(){
  playBtn.innerHTML = '&#10074;&#10074;';
  playTimer = setInterval(() => {
    let y = parseInt(slider.value, 10) + 1;
    if (y > MAX_YEAR) y = MIN_YEAR;
    setYear(y);
  }, parseInt(speedSelect.value, 10));
}
playBtn.addEventListener('click', () => {
  if (playTimer) stopPlay(); else startPlay();
});
speedSelect.addEventListener('change', () => {
  if (playTimer){ stopPlay(); startPlay(); }
});

// initialize on 1776 for a non-empty first view
setYear(1776);
</script>
</body>
</html>
